<% layout("/layouts/boilerplate.ejs") %>
    <script>
        const mapToken = "<%= process.env.MAP_TOKEN %>";
        const listing = <%- JSON.stringify(listingData) %>;
    </script>
    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-lg border-0">

                <img src="<%= listingData.image.url %>" class="card-img-top listing-img" alt="<%= listingData.title %>">

                <div class="card-body">

                    <h2 class="card-title fw-bold">
                        <%= listingData.title %>
                    </h2>


                    <p class="text-muted">

                        <%= listingData.location %>,

                            <%= listingData.country %>
                    </p>
                    <p class="text-muted">
                        Username: <%= listingData.owner.username %>
                    </p>


                    <hr>


                    <p class="card-text">

                        <%= listingData.description %>

                    </p>


                    <h4 class="text-success">

                        ₹ <%= listingData.price %>

                    </h4>
                    <% if(currUser && listingData.owner._id.equals(currUser._id)) {%>
                        <div class="mt-4">

                            <a href="/listings/<%= listingData._id %>/edit" class="btn btn-warning me-2">
                                Edit
                            </a>


                            <form action="/listings/<%= listingData._id %>?_method=DELETE" method="POST"
                                class="d-inline">

                                <button class="btn btn-danger">
                                    Delete
                                </button>

                            </form>

                        </div>
                        <% } %>

                </div>

            </div>


            <!-- Review -->
            <% if(currUser) {%>
                <div class="card mt-4 shadow-sm">

                    <div class="card-body">

                        <h4 class="mb-3">
                            Leave a Review
                        </h4>


                        <form action="/listings/<%= listingData._id %>/reviews" method="POST" novalidate
                            class="needs-validation review-form">

                            <!-- Rating -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    Rating
                                </label>

                                <fieldset class="starability-slot">
                                    <legend class="visually-hidden">Rating</legend>

                                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]"
                                        value="0">

                                    <input type="radio" id="first-rate1" name="review[rating]" value="1">
                                    <label for="first-rate1" title="Terrible">1 star</label>

                                    <input type="radio" id="first-rate2" name="review[rating]" value="2">
                                    <label for="first-rate2" title="Not good">2 stars</label>

                                    <input type="radio" id="first-rate3" name="review[rating]" value="3" checked>
                                    <label for="first-rate3" title="Average">3 stars</label>

                                    <input type="radio" id="first-rate4" name="review[rating]" value="4">
                                    <label for="first-rate4" title="Very good">4 stars</label>

                                    <input type="radio" id="first-rate5" name="review[rating]" value="5">
                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>
                            </div>


                            <!-- Comment -->
                            <div class="mb-3">
                                <label for="comment" class="form-label fw-semibold">
                                    Comment
                                </label>

                                <textarea name="review[comment]" id="comment" rows="4" class="form-control"
                                    placeholder="Share your experience..." required></textarea>

                                <div class="invalid-feedback">
                                    Please enter a comment.
                                </div>
                            </div>


                            <!-- Submit -->
                            <button type="submit" class="btn btn-primary">
                                Submit Review
                            </button>

                        </form>
                    </div>

                </div>
                <% } %>

                    <!-- All Reviews -->
                    <% if(listingData.reviews.length> 0) {%>
                        <div class="mt-4">

                            <h3 class="mb-3">
                                All Reviews
                            </h3>


                            <% for(let review of listingData.reviews){ %>

                                <div class="card mb-3 shadow-sm">

                                    <div class="card-body">

                                        <p class="mb-3">
                                            @<b>
                                                <%= review.author.username %>
                                            </b>
                                        </p>

                                        <p class="starability-result" data-rating="<%= review.rating %>">
                                        </p>

                                        <p class="mb-3">
                                            <%= review.comment %>
                                        </p>


                                        <form
                                            action="/listings/<%= listingData._id %>/reviews/<%= review._id %>?_method=DELETE"
                                            method="POST">

                                            <button class="btn btn-danger">
                                                Delete Review
                                            </button>

                                        </form>

                                    </div>

                                </div>

                                <% } %>

                        </div>
                        <% } %>
        </div>
<!-- Map -->
<div class="row justify-content-center mt-5">
    <div class="col-12 col-md-10 col-lg-8">

        <div class="card border-0 shadow-sm">
            <div class="card-body">

                <h3 class="card-title fw-bold mb-4">
                    Where you'll be
                </h3>

                <div id="map" class="rounded overflow-hidden border"></div>

            </div>
        </div>

    </div>
</div>

<script src="/js/map.js"></script>